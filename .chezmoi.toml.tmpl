{{- $machineType := promptStringOnce . "machineType" "Machine type (personal/work)" -}}

{{/* linuxEnvはboolで保存されるため、再初期化では既存フラグから選択値を復元する。 */}}
{{- $environmentData := dict -}}
{{- range $flag, $name := dict "nativeUbuntu" "native-ubuntu" "wslUbuntu" "wsl-ubuntu" "qemuUbuntu" "qemu-ubuntu" "prootUbuntu" "proot-ubuntu" "termux" "termux" -}}
  {{- if get $ $flag -}}
    {{- $_ := set $environmentData "linuxEnv" $name -}}
  {{- end -}}
{{- end -}}
{{- if get . "termux" -}}
  {{- $_ := set $environmentData "linuxEnv" "termux" -}}
{{- end -}}
{{- $linuxEnv := "false" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $linuxEnv = promptStringOnce $environmentData "linuxEnv" "Execute Linux Environment (native-ubuntu/wsl-ubuntu/qemu-ubuntu/proot-ubuntu/termux)" -}}
{{- else if eq .chezmoi.os "android" -}}
  {{- $linuxEnv = promptStringOnce $environmentData "linuxEnv" "Execute Linux Environment (termux/qemu-ubuntu/proot-ubuntu)" -}}
{{- end -}}
{{- $provider := "keyring" -}}
{{- if or (eq $linuxEnv "termux") (eq $linuxEnv "proot-ubuntu") -}}
  {{- $provider = "env" -}}
{{- else -}}
  {{- $provider = promptStringOnce . "protonPassProvider" "Proton Pass provider (env/keyring)" -}}
{{- end -}}
{{- if not (or (eq $provider "env") (eq $provider "keyring")) -}}
  {{- fail "Proton Pass providerにはenvまたはkeyringを指定してください" -}}
{{- end -}}

{{/* 初回も展開先を参照する。make wrapperで先に展開し、生のテンプレートは実行しない。 */}}
{{- $command := joinPath .chezmoi.homeDir ".local/bin/proton-pass" -}}

[data]
  personal = {{ eq $machineType "personal" }}
  work = {{ eq $machineType "work" }}
  {{ if ne $linuxEnv "false" -}}
  linuxEnv = true
  {{ else -}}
  linuxEnv = false
  {{ end -}}
  nativeUbuntu = {{ eq $linuxEnv "native-ubuntu" }}
  wslUbuntu = {{ eq $linuxEnv "wsl-ubuntu" }}
  termux = {{ eq $linuxEnv "termux" }}
  qemuUbuntu = {{ eq $linuxEnv "qemu-ubuntu" }}
  prootUbuntu = {{ eq $linuxEnv "proot-ubuntu" }}
  protonPassProvider = {{ $provider | quote }}

[diff]
  exclude = [
    "externals",
    "scripts"
  ]

[edit]
  command = "nvim"

[protonPass]
  command = {{ $command | quote }}

