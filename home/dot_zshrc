# Created by newuser for 5.9

# zshの設定ファイルディレクトリ
export ZDIR=$HOME/.zsh

# シェルに依存しない汎用関数
export SCRIPTS_DIR=$HOME/scripts
source $SCRIPTS_DIR/shell/funciton.sh

source $ZDIR/path.zsh
source $ZDIR/operation.zsh

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if [[ -r "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
  export BREW_PREFIX=$(brew --prefix)
  export HOMEBREW_BUNDLE_NO_DESCRIBE=1
fi

# proot-distro環境でのみ適用
if [[ -n "${PROOT_L2S_DIR:-}" ]]; then
  export HOMEBREW_NO_SANDBOX_LINUX=1
  alias cd_android='cd /sdcard'
fi

if type mise > /dev/null; then
  eval "$(mise activate zsh)"
fi

source $ZDIR/completion.zsh
source $ZDIR/plugin.zsh

if type zoxide > /dev/null; then
  eval "$(zoxide init zsh --cmd cd)"
fi

if type atuin >/dev/null; then
  eval "$(atuin init zsh)"
fi
source $ZDIR/alias.zsh

foreach script ($ZDIR/functions/*.zsh) {
  source $script
}

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

export LANG=ja_JP.UTF-8
export LANGUAGE="ja_JP:ja"
