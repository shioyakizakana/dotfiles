#!/usr/bin/env bash

set -euo pipefail
umask 077

# 明示指定がある場合は優先する。
# 未指定の場合はchezmoiの環境判定を利用する。
resolve_provider() {
  if [[ -n "${PROTON_PASS_KEY_PROVIDER:-}" ]]; then
    printf '%s\n' "$PROTON_PASS_KEY_PROVIDER"
    return 0
  fi

  {{ if .nativeUbuntu -}}
  printf '%s\n' keyring
  {{ else if .termux -}}
  printf '%s\n' env
  {{ else if .prootUbuntu -}}
  printf '%s\n' env
  {{ else if .qemuUbuntu -}}
  printf '%s\n' keyring
  {{ else if .wslUbuntu -}}
  printf '%s\n' keyring
  {{ else -}}
  printf '%s\n' "未対応の環境です" >&2
  return 1
  {{ end -}}
}

readonly PROVIDER="$(resolve_provider)"

# 共通パス
readonly DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pass-cli"
readonly PAT_FILE="$DATA_DIR/token.age"
readonly ENCRYPTION_FILE="$DATA_DIR/encryption-key.age"
readonly AGE_IDENTITY_FILE="${AGE_IDENTITY_FILE:-${XDG_DATA_HOME:-$HOME/.local/share}/age/id_proton_pat}"

decrypt_secret() {
  local file="$1"

  if [[ ! -r "$file" ]]; then
    printf '暗号化ファイルが読み取れません: %s\n' "$file" >&2
    return 1
  fi

  age --decrypt \
    --identity "$AGE_IDENTITY_FILE" \
    "$file"
}

main() {
  local encryption_key=""
  local token=""

  case "$PROVIDER" in
  keyring)
    ;;
  env)
    encryption_key="$(decrypt_secret "$ENCRYPTION_FILE")"

    if [[ -z "$encryption_key" ]]; then
      printf 'データベース暗号化鍵が空です。\n' >&2
      return 1
    fi
    ;;
  *)
    printf '未対応のprovider: %s\n' "$PROVIDER" >&2
    return 1
    ;;
  esac

  # PATはログイン時だけ復号する。
  if [[ "${1:-}" == "login" ]]; then
    token="$(decrypt_secret "$PAT_FILE")"

    if [[ -z "$token" ]]; then
      printf 'PATが空です。\n' >&2
      return 1
    fi
  fi

  (
    export PROTON_PASS_KEY_PROVIDER="$PROVIDER"

    if [[ "$PROVIDER" == "env" ]]; then
      export PROTON_PASS_ENCRYPTION_KEY="$encryption_key"
    else
      unset PROTON_PASS_ENCRYPTION_KEY
    fi

    if [[ -n "$token" ]]; then
      export PROTON_PASS_PERSONAL_ACCESS_TOKEN="$token"
    else
      unset PROTON_PASS_PERSONAL_ACCESS_TOKEN
    fi

    unset encryption_key token

    exec pass-cli "$@"
  )
}

main "$@"
