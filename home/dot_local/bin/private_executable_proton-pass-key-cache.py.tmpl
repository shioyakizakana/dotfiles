#!/usr/bin/env python3
"""Proton Passのenvプロバイダー向け一時鍵キャッシュ（Linux / Android Termux）。

CLIのデータベース暗号化鍵（64桁の16進数）だけを常駐プロセスのメモリに保持する。
PATとage identityはキャッシュしない。
"""

import argparse
import fcntl
import json
import os
import socket
import stat
import struct
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_TTL = 900
MAX_TTL = 3600
MAX_MSG = 4096


def fail(message: str) -> None:
    print(f"[-] {message}", file=sys.stderr)
    raise SystemExit(1)


def paths() -> tuple[Path, Path, Path]:
    base = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    identity_base = Path(os.environ.get("AGE_IDENTITY_DIR") or base / "age")
    identity = Path(
        os.environ.get("AGE_IDENTITY_FILE") or identity_base / "id_proton_pat.age"
    )
    encryption_file = base / "proton-pass/encryption-key.age"
    runtime = Path(
        os.environ.get("PROTON_PASS_CACHE_DIR")
        or Path.home() / ".cache/proton-pass-key-cache"
    )
    return identity, encryption_file, runtime


def check_dir(path: Path) -> None:
    # キャッシュディレクトリへのシンボリックリンクを拒否し、所有者と権限を確認する。
    # このディレクトリには平文の秘密情報を保存しない。
    if path.is_symlink():
        fail(f"キャッシュディレクトリにシンボリックリンクは使用できません: {path}")
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    st = path.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        fail(f"キャッシュディレクトリの所有者・権限が不正です: {path} (0700が必要)")


def request(sock_path: Path, msg: dict) -> dict:
    client = socket.socket(socket.AF_UNIX)
    client.settimeout(2)
    try:
        client.connect(str(sock_path))
        client.sendall(json.dumps(msg).encode() + b"\n")
        chunks = bytearray()
        while not chunks.endswith(b"\n"):
            piece = client.recv(1024)
            if not piece:
                raise OSError("応答が途中で切断されました")
            chunks.extend(piece)
            if len(chunks) > MAX_MSG:
                raise OSError("応答が長すぎます")
        return json.loads(chunks)
    finally:
        client.close()


def try_request(path: Path, msg: dict) -> dict | None:
    try:
        return request(path, msg)
    except (OSError, ValueError):
        return None


def key_valid(key: str) -> bool:
    return len(key) == 64 and all(c in "0123456789abcdefABCDEF" for c in key)


def decrypt_key(identity: Path, encrypted: Path) -> str:
    for path in (identity, encrypted):
        if path.is_symlink() or not path.is_file() or not os.access(path, os.R_OK):
            fail(f"秘密情報ファイルを読み取れません: {path}")
    result = subprocess.run(
        ["age", "-d", "-i", str(identity), str(encrypted)],
        stdout=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        fail("CLI暗号化鍵の復号に失敗しました")
    key = result.stdout.decode("ascii", errors="strict").strip()
    if not key_valid(key):
        fail("CLI暗号化鍵の形式が不正です（64桁の16進数が必要）")
    return key


def serve(sock_path: Path, ttl: int, lock_path: Path) -> None:
    # エージェントの稼働中は排他ロックを保持し、二重起動を防止する。
    with lock_path.open("a+b") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        if sock_path.exists() or sock_path.is_symlink():
            st = sock_path.lstat()
            if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid():
                return
            try:
                sock_path.unlink()
            except OSError:
                return
        key = None
        expiry = 0.0
        with socket.socket(socket.AF_UNIX) as server:
            server.bind(str(sock_path))
            os.chmod(sock_path, 0o600)
            server.listen(8)
            server.settimeout(0.5)
            try:
                while True:
                    if key is not None and time.monotonic() >= expiry:
                        break
                    try:
                        conn, _ = server.accept()
                    except TimeoutError:
                        continue
                    with conn:
                        try:
                            conn.settimeout(2)
                            creds = conn.getsockopt(
                                socket.SOL_SOCKET, socket.SO_PEERCRED, 12
                            )
                            _, peer_uid, _ = struct.unpack("3i", creds)
                            if peer_uid != os.getuid():
                                continue
                            data = bytearray()
                            while not data.endswith(b"\n"):
                                part = conn.recv(1024)
                                if not part or len(data) + len(part) > MAX_MSG:
                                    raise ValueError("invalid request")
                                data.extend(part)
                            req = json.loads(data)
                            op = req.get("op")
                            now = time.monotonic()
                            if op == "put" and key is None:
                                proposed = req.get("key", "")
                                if not isinstance(proposed, str) or not key_valid(
                                    proposed
                                ):
                                    response = {"ok": False}
                                else:
                                    key = proposed
                                    expiry = now + ttl
                                    response = {"ok": True}
                            elif op == "get" and key is not None and now < expiry:
                                response = {"ok": True, "key": key}
                            elif op == "status":
                                response = {
                                    "ok": key is not None and now < expiry,
                                    "remaining": max(0, int(expiry - now))
                                    if key
                                    else 0,
                                }
                            elif op == "lock":
                                response = {"ok": True}
                                conn.sendall(json.dumps(response).encode() + b"\n")
                                break
                            else:
                                response = {"ok": False}
                            conn.sendall(json.dumps(response).encode() + b"\n")
                        except (OSError, ValueError, TypeError, json.JSONDecodeError):
                            pass
            finally:
                try:
                    sock_path.unlink()
                except OSError:
                    pass


def unlock(
    identity: Path, encrypted: Path, sock_path: Path, lock_path: Path, ttl: int
) -> None:
    if (reply := try_request(sock_path, {"op": "status"})) and reply.get("ok"):
        return
    key = decrypt_key(identity, encrypted)
    if not (reply := try_request(sock_path, {"op": "status"})):
        subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_serve", str(ttl)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
        for _ in range(50):
            if (reply := try_request(sock_path, {"op": "status"})) is not None:
                break
            time.sleep(0.05)
    if reply and reply.get("ok"):
        return
    if not (
        reply := try_request(sock_path, {"op": "put", "key": key})
    ) or not reply.get("ok"):
        fail("暗号化鍵のキャッシュに失敗しました")


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Proton Passの暗号化鍵を期限付きでメモリキャッシュ"
    )
    parser.add_argument(
        "command", choices=("unlock", "status", "lock", "run", "_serve")
    )
    parser.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    identity, encrypted, runtime = paths()
    check_dir(runtime)
    sock_path = runtime / "agent.sock"
    lock_path = runtime / "agent.lock"
    if args.command == "_serve":
        if len(args.arguments) != 1:
            fail("invalid daemon arguments")
        serve(sock_path, int(args.arguments[0]), lock_path)
        return
    ttl_raw = os.environ.get("PROTON_PASS_CACHE_TTL", str(DEFAULT_TTL))
    try:
        ttl = int(ttl_raw)
    except ValueError:
        fail("PROTON_PASS_CACHE_TTLは整数で指定してください")
    if not 1 <= ttl <= MAX_TTL:
        fail(f"キャッシュ期限は1〜{MAX_TTL}秒で指定してください")
    if args.command == "status":
        reply = try_request(sock_path, {"op": "status"})
        print(
            f"unlock済み（残り{reply['remaining']}秒）"
            if reply and reply.get("ok")
            else "ロック中"
        )
        return
    if args.command == "lock":
        reply = try_request(sock_path, {"op": "lock"})
        print(
            "キャッシュをロックしました"
            if reply and reply.get("ok")
            else "既にロック中"
        )
        return
    if args.command == "unlock":
        unlock(identity, encrypted, sock_path, lock_path, ttl)
        print("CLI暗号化鍵を一時的にキャッシュしました")
        return
    # runでは鍵を標準出力に出さず、pass-cliの実行環境にのみ渡す。
    cli_args = args.arguments
    if cli_args and cli_args[0] == "--":
        cli_args = cli_args[1:]
    if not cli_args:
        fail("使用方法: proton-pass-key-cache run -- <pass-cliの引数>")
    reply = try_request(sock_path, {"op": "get"})
    if not reply or not reply.get("ok"):
        unlock(identity, encrypted, sock_path, lock_path, ttl)
        reply = try_request(sock_path, {"op": "get"})
    if not reply or not reply.get("ok"):
        fail("キャッシュから暗号化鍵を取得できません")
    env = os.environ.copy()
    env["PROTON_PASS_KEY_PROVIDER"] = "env"
    env["PROTON_PASS_ENCRYPTION_KEY"] = reply["key"]
    os.execvpe("pass-cli", ["pass-cli", *cli_args], env)


if __name__ == "__main__":
    main()
