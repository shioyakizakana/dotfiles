#!/usr/bin/env bash
set -uo pipefail

log() {
  printf '\n==> %s\n' "$*"
}

update_apt() {
  command -v apt-get >/dev/null 2>&1 || return 0

  log "Updating APT..."

  sudo apt-get update &&
    sudo apt-get upgrade -y &&
    sudo apt-get autoremove -y &&
    sudo apt-get autoclean -y
}

update_brew() {
  command -v brew >/dev/null 2>&1 || return 0

  log "Updating Homebrew..."

  brew update &&
    brew upgrade &&
    brew cleanup
}

update_mise() {
  command -v mise >/dev/null 2>&1 || return 0

  log "Updating mise..."

  mise outdated || true
  mise upgrade
}

run_update() {
  local target="$1"

  log "Starting: $target"

  if "update_${target}"; then
    log "SUCCESS: $target"
    return 0
  else
    log "FAILED: $target"
    return 1
  fi
}

main() {
  local target
  local failures=0

  if (($# == 0)); then
    printf 'Usage: %s {apt|brew|mise|all} [...]\n' "$0" >&2
    return 2
  fi

  local -a targets=()

  for target in "$@"; do
    case "$target" in
    all)
      targets+=(apt brew mise)
      ;;
    apt | brew | mise)
      targets+=("$target")
      ;;
    *)
      printf 'Unknown target: %s\n' "$target" >&2
      return 2
      ;;
    esac
  done

  for target in "${targets[@]}"; do
    if ! run_update "$target"; then
      ((failures += 1))
    fi
  done

  if ((failures > 0)); then
    log "$failures update target(s) failed."
    return 1
  fi

  log "All selected updates completed successfully."
}

main "$@"
