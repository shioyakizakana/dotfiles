#!/usr/bin/env bash
set -euo pipefail
umask 077

# Proton Pass CLIの初期ログイン用エントリーポイント。
# 秘密情報の復号とpass-cliの実行はproton-passラッパーに委ねる。
# setup-proton-pass.shと同じidentityのデフォルトパスを使う。

die() {
  printf '[-] ' >&2
  printf "$1\n" "${@:2}" >&2
  exit 1
}

require() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 ||
      die '必要なコマンドが見つかりません: %s' "$cmd"
  done
}

resolve_provider() {
  local configured_provider={{ .protonPassProvider | quote }}
  local requested="${PROTON_PASS_KEY_PROVIDER:-$configured_provider}"

  case "$requested" in
  env | keyring) printf '%s\n' "$requested" ;;
  *) die '未対応のprovider: %s' "$requested" ;;
  esac
}

require_secret_file() {
  local name="$1" path="$2"

  [[ ! -L "$path" && -f "$path" &&
    -s "$path" && -r "$path" ]] ||
    die '%sが見つからないか、読み取れません: %s' \
      "$name" "$path"
}

main() {
  (($# == 0)) ||
    die '引数は受け付けません（使用方法: %s）' "$0"

  provider="$(resolve_provider)"

  local provider

  local -r DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/proton-pass"
  local -r IDENTITY_DIR="${AGE_IDENTITY_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/age}"
  local -r IDENTITY_FILE="${AGE_IDENTITY_FILE:-$IDENTITY_DIR/id_proton_pat.age}"
  local -r PAT_FILE="$DATA_DIR/token.age"
  local -r ENCRYPTION_FILE="$DATA_DIR/encryption-key.age"
  local -r PASS_WRAPPER="$HOME/.local/bin/proton-pass"

  provider="$(resolve_provider)" || die 'providerを決定できませんでした'
  require age pass-cli

  [[ -f "$PASS_WRAPPER" && -x "$PASS_WRAPPER" &&
    ! -L "$PASS_WRAPPER" ]] ||
    die 'Proton Passラッパーが存在しないか実行できません: %s' \
      "$PASS_WRAPPER"

  require_secret_file '暗号化PAT' "$PAT_FILE"
  require_secret_file '暗号化identity' "$IDENTITY_FILE"

  if [[ "$provider" == env ]]; then
    require_secret_file '暗号化鍵' "$ENCRYPTION_FILE"
  fi

  export PROTON_PASS_KEY_PROVIDER="$provider"
  export AGE_IDENTITY_FILE="$IDENTITY_FILE"

  exec "$PASS_WRAPPER" login
}

main "$@"
