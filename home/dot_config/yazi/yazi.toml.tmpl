[mgr]
show_hidden = true
linemode = "mtime"

{{ if get . "termux" -}}
# Termuxではresvgが画像用のメモリ上限下で起動できない。
[[plugin.prepend_previewers]]
mime = "image/svg+xml"
run = "magick"

[[plugin.prepend_preloaders]]
mime = "image/svg+xml"
run = "magick"

{{ end -}}
[[plugin.prepend_fetchers]]
group = "git"
url = "*"
run = "git"

[[plugin.prepend_fetchers]]
group = "git"
url = "*/"
run = "git"

[opener]
edit = [
  { run = "$EDITOR %s", block = true ,for = "unix" },
]
preview = [
  { run = "qlmanage -p %s1", desc = "Quick Look Preview" },
]

[open]
prepend_rules = [
  { mime = "text/*", use = "edit" },
  { url = "*.html", use = [ "open", "edit" ] },
]
