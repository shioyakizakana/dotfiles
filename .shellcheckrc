# 拡張子がないスクリプトの標準シェルを指定
shell=bash

# 外部スクリプトの検索ルートパス
# SCRIPTDIRで、そのスクリプトがあるディレクトリを基準とする
source-path=SCRIPTDIR

# SC1071:
# シェバンのシェル種別をshellcheckが認識できない警告
# (zshや独自環境向けスクリプトを許容)

# SC1090:
# sourceの読み込み先が変数展開されており解析できない警告
# (動的に決定される設定ファイルの読み込みを許容)

# SC2034:
# 参照されていない変数の警告
# (設定値、定数、export用変数などを許容)

# SC2119:
# 引数なし関数呼び出し時に()が省略されている警告
# (POXIXシェルで一般的な呼び出し方を許容)

# SC2120:
# 関数が引数を参照しているのに引数なしで呼び出されている警告
# (デフォルト引数的な実装を許容)

# SC2155:
# ローカル変数宣言と代入を同時に行う警告
# (local var=$(cmd)のような記述を許容)

# SC2164:
# cdの失敗チェックが行われていない警告
# (set -eやerrexit前提の運用を許容)
# SC2207:
# 配列代入時のword splittingに関する警告
# (mapfile非対応環境での配列生成を許容)

disable=SC1071,SC1090,SC2034,SC2119,SC2120,SC2155,SC2164,SC2207
